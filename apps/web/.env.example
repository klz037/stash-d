# Auth0 SPA application
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://stashd-api

# Leave blank in local dev to use the Vite proxy (api + socket.io → :3000)
VITE_API_URL=

# Step-up MFA on "second key" locks. Leave false until the tenant has an MFA
# factor enabled and the post-login Action that sets https://stashd/mfa.
VITE_MFA_STEPUP=false
