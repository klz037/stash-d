# Auth0 — API application / identifier (no secrets required for JWT validation)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://stashd-api

# MongoDB (docker compose service in repo root)
MONGODB_URI=mongodb://127.0.0.1:27017/stashd

# HTTP
PORT=3000
# Comma-separated. Every origin the web app is served from, including the
# Vercel URL. An origin missing here is blocked by CORS and the app shows
# "Failed to fetch" right after sign-in.
WEB_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Spotify (optional — song stashing is disabled without it)
# Create an app at developer.spotify.com/dashboard and add this exact redirect URI.
# Spotify rejects the hostname "localhost" — loopback redirects must use 127.0.0.1.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Auth0 Token Vault (optional — calendar prompts are disabled without it)
# A "Custom API Client" issued by Auth0 for the stashd API, with the Token Vault
# grant enabled. The API exchanges each user's Auth0 access token for their
# Google token and reads the next two weeks of their calendar. See auth0/README.md.
AUTH0_TOKEN_VAULT_CLIENT_ID=
AUTH0_TOKEN_VAULT_CLIENT_SECRET=
AUTH0_CALENDAR_CONNECTION=google-oauth2

# IFM (optional — composes stash alert copy; falls back to local templates)
# OpenAI-compatible chat completions endpoint, e.g. https://api.example.com/v1
IFM_API_URL=
IFM_API_KEY=
IFM_MODEL=IFM/K2-Horizon-7B

# Device stash alerts (Web Push). Generate once: `npx web-push generate-vapid-keys`
# Without these, alerts are still generated and shown in-app, but no OS push is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
