# Convenience copy of the app env files.
# Prefer apps/api/.env and apps/web/.env — Nest and Vite load those.

# API
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://stashd-api
MONGODB_URI=mongodb://127.0.0.1:27017/stashd
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Web (Vite only reads VITE_* from apps/web/.env)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://stashd-api
VITE_API_URL=
