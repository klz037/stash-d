# Convenience copy of the app env files.
# Prefer apps/api/.env and apps/web/.env — Nest and Vite load those.

# API
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://stashd-api
MONGODB_URI=mongodb://127.0.0.1:27017/stashd
PORT=3000
WEB_ORIGIN=http://localhost:5173

# IFM (optional — shelf prompt composition)
IFM_API_URL=
IFM_API_KEY=
IFM_MODEL=IFM/K2-Horizon-7B

# Web (Vite only reads VITE_* from apps/web/.env)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://stashd-api
VITE_API_URL=

# Device stash alerts (Web Push). Generate once: `npx web-push generate-vapid-keys`
# Without these, alerts are still generated and shown in-app, but no OS push is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
